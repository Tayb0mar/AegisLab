# ---------------------------------------------------------------------------
# AegisLab configuration template.
# Copy this file to `.env` and adjust the values. Never commit `.env`.
# Every value here is a development default or placeholder, not a measured truth.
# ---------------------------------------------------------------------------

# Operating mode of the data source:
#   mock   - built-in simulator, no Arduino required (default)
#   serial - real Arduino over USB serial
#   off    - API only, no collector thread
AEGIS_MODE=mock

# Serial (only used when AEGIS_MODE=serial)
# SERIAL_PORT is a PLACEHOLDER: check the real port in Arduino IDE > Tools > Port
# or Windows Device Manager, then update it.
SERIAL_PORT=COM3
BAUD_RATE=9600
SERIAL_TIMEOUT_SECONDS=2
SERIAL_RECONNECT_DELAY_SECONDS=5

# Device health timeouts
READING_STALE_AFTER_SECONDS=8
DEVICE_OFFLINE_AFTER_SECONDS=20

# Database backend:
#   mysql  - official backend (default). Requires the settings below.
#   memory - volatile in-memory store for demos/automated tests only.
#            Data is lost on restart. Not a persistence option.
DB_BACKEND=mysql

# MySQL (credentials are placeholders - use your own MySQL Workbench account)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aegislab
DB_USER=aegislab_app
DB_PASSWORD=replace_me

# API
API_HOST=127.0.0.1
API_PORT=8000
HISTORY_DEFAULT_LIMIT=100
HISTORY_MAX_LIMIT=1000
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Alert thresholds - development defaults; tune from real sensor behaviour
HIGH_TEMPERATURE_C=30.0
LOW_HUMIDITY_PERCENT=30.0
DARK_LIGHT_LEVEL=100
ALERT_COOLDOWN_SECONDS=300
RAPID_TEMPERATURE_WINDOW_SECONDS=300
RAPID_TEMPERATURE_CHANGE_C=5.0

# Validation ranges (plausible physical bounds, not calibrated values)
TEMPERATURE_MIN_C=-40
TEMPERATURE_MAX_C=85
LIGHT_MIN=0
LIGHT_MAX=1023

# Optional anomaly detection (advisory only, rule alerts stay authoritative)
ANOMALY_ENABLED=false
ANOMALY_WINDOW_SIZE=300
ANOMALY_ZSCORE_THRESHOLD=3.5

# Optional LLM feature - leave blank unless implemented
LLM_API_KEY=
